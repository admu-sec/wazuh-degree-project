<!-- Windows Security Rules -->
<!-- ====================================== -->

<!-- Windows Security Rules -->
<group name="local,windows,attack">

    <!-- Rule 100044: LOLBins Detection -->
    <rule id="100044" level="12">
        <if_group>sysmon_event1</if_group>
        <field name="win.eventdata.commandLine" type="pcre2">certutil|bitsadmin|mshta|regsvr32|rundll32</field>
        <description>CRITICAL: Living-off-the-land binary (LOLBin) executed - potential attack.</description>
        <mitre>
            <id>T1218.003</id>
            <id>T1218.005</id>
            <id>T1218.010</id>
            <id>T1218.011</id>
        </mitre>
        <group>lolbins,defense_evasion,</group>
    </rule>

    <!-- Rule 100045: Scheduled Task Created -->
    <rule id="100045" level="10">
        <if_sid>60103</if_sid>
        <field name="win.system.eventID">^4698$</field>
        <description>CRITICAL: Scheduled Task created - potential persistence mechanism.</description>
        <mitre>
            <id>T1053.005</id>
        </mitre>
        <group>scheduled_task,persistence,</group>
    </rule>

<!-- Rule 100046: Process Injection - ProcessAccess -->
<rule id="100046" level="12">
    <if_group>sysmon_event_10</if_group>
    <field name="win.eventdata.targetImage" type="pcre2">lsass.exe|winlogon.exe|csrss.exe</field>
    <description>CRITICAL: Suspicious process access - potential process injection or credential dumping.</description>
    <mitre>
        <id>T1055</id>
        <id>T1003.001</id>
    </mitre>
    <group>process_injection,credential_access,</group>
</rule>

  <!-- Rule 100047: Suspicious Named Pipe - C2/Cobalt Strike -->
<rule id="100047" level="12">
    <if_group>sysmon_event_17</if_group>
    <field name="win.eventdata.pipeName" type="pcre2">\\postex_|\\msagent_|\\status_|MSSE-|cachedump|wceservicepipe</field>
    <description>CRITICAL: Suspicious named pipe detected - potential C2 or credential dumping tool.</description>
    <mitre>
        <id>T1055.001</id>
    </mitre>
    <group>named_pipe,c2,defense_evasion,</group>
</rule>

<!-- Rule 100048: WMI Event Subscription -->
<rule id="100048" level="12">
    <if_sid>60009</if_sid>
    <field name="win.system.eventID">^5861$</field>
    <description>CRITICAL: WMI Event Subscription created - potential persistence mechanism.</description>
    <mitre>
        <id>T1546.003</id>
    </mitre>
    <group>wmi,persistence,</group>
</rule>

<!-- Rule 100049: Screen Capture -->
<rule id="100049" level="12">
  <if_group>sysmon</if_group>
  <field name="win.eventdata.image" type="pcre2">(?i)(snippingtool|screencapture|nircmd)</field>
  <description>CRITICAL: Screen capture tool executed - potential data collection.</description>
  <mitre>
    <id>T1113</id>
  </mitre>
</rule>

<!-- Rule 100050: Process Discovery -->
<rule id="100050" level="8">
  <if_sid>61603</if_sid>
  <field name="win.eventdata.commandLine" type="pcre2">(?i)(tasklist|Get-Process|wmic)</field>
  <description>Process discovery command executed - reconnaissance activity.</description>
  <mitre>
    <id>T1057</id>
  </mitre>
</rule>

<!-- Rule 100051: Archive Collected Data -->
<rule id="100051" level="12">
  <if_sid>61603</if_sid>
  <field name="win.eventdata.image" type="pcre2">(?i)(7z|winrar|compress|zip)</field>
  <description>CRITICAL: Archiving tool executed - potential data staging before exfiltration.</description>
  <mitre>
    <id>T1560</id>
  </mitre>
</rule>
  
</group>
