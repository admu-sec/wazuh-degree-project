<!-- Example -->
<group name="local,syslog,sshd">

  <!--
  Dec 10 01:02:02 host sshd[1234]: Failed none for root from 1.1.1.1 port 1066 ssh2
  -->
  <rule id="100001" level="10">
    <if_sid>5710, 5711, 5712, 5716</if_sid>
    <description>sshd: Authentication failed attempt detected.</description>
    <mitre>
      <id>T1110.001</id>
      <id>T1078</id>
    </mitre>
    <group>authentication_failed,pci_dss_10.2.4,pci_dss_10.2.5,</group>
  </rule>

  <rule id="100002" level="10" frequency="5" timeframe="300">
    <if_matched_sid>100001</if_matched_sid>
    <same_source_ip />
    <description>sshd: Brute force attack detected (5+ failures in 5min)</description>
    <mitre>
      <id>T1110.001</id>
    </mitre>
    <group>authentication_failed,attack,brute_force,</group>
  </rule>

  <rule id="100003" level="12" frequency="10" timeframe="120">
    <if_matched_sid>100001</if_matched_sid>
    <same_user />
    <description>sshd: Password spray attack - same account targeted from multiple IP's.</description>
    <mitre>
      <id>T1110.003</id>
    </mitre>
    <group>authentication_failed,password_spray,attack,</group>
  </rule>

  <rule id="100004" level="14">
    <if_sid>5715</if_sid>
    <description>CRITICAL: Successful SSH login after recent failed attempts - possible breach.</description>
    <mitre>
      <id>T1078</id>
    </mitre>
    <group>authentication_success,successful_attack,</group>
  </rule>

</group>

<group name="windows,syscheck,sysmon">

  <!-- Noise Reduction -->
  <rule id="100005" level="0">
    <if_sid>554,61603,61613</if_sid>
    <field name="win.eventdata.image">\\cleanmgr.exe</field>
    <description>Ignore False Positive from Windows Disk Cleanup</description>
  </rule>

  <rule id="100006" level="0">
    <if_sid>554</if_sid>
    <field name="win.eventdata.image" type="pcre2">\\TiWorker\.exe$|\\wuauclt\.exe$|\\TrustedInstaller\.exe$</field>
    <description>Ignore Windows Update service file changes</description>
  </rule>

  <!-- DC Admin Login -->
  <rule id="100010" level="12">
    <if_sid>92657</if_sid>
    <field name="win.eventdata.targetUserName">Administrator</field>
    <description>Critical Event: Remote login using Administrator account on Domain Controller</description>
    <mitre>
      <id>T1078</id>
    </mitre>
  </rule>

  <!-- PowerShell & Mimikatz (kräver Sysmon) -->
  <rule id="100011" level="12">
    <if_sid>61699</if_sid>
    <field name="win.eventdata.commandLine" type="pcre2">-enc|-encodedcommand|-e\s+[A-Za-z0-9+/]{50,}</field>
    <description>PowerShell encoded command execution detected</description>
    <mitre>
      <id>T1059.001</id>
      <id>T1027</id>
    </mitre>
    <group>powershell,attack,</group>
  </rule>

  <rule id="100012" level="15">
    <if_sid>61699</if_sid>
    <field name="win.eventdata.commandLine" type="pcre2">($|sekurlsa|lsadump|privilege::debug|mimikat</field>
    <description>CRITICAL: Mimikatz credential dumping attempt detected</description>
    <mitre>
      <id>T1003.001</id>
    </mitre>
    <group>credential_dumping,attack,</group>
  </rule>

  <!-- RDP Brute Force -->
  <rule id="100013" level="10" frequency="5" timeframe="300">
    <if_matched_sid>60122</if_matched_sid>
    <same_source_ip />
    <description>RDP Brute Force: Multiple failed logins detected</description>
    <mitre>
      <id>T1110</id>
    </mitre>
    <group>windows,rdp,brute_force,</group>
  </rule>

  <!-- New Service -->
  <rule id="100014" level="10">
    <if_sid>60612</if_sid>
    <field name="win.system.eventID">^7045$</field>
    <description>New Windows service installed - potential persistence mechanism</description>
    <mitre>
      <id>T1543.003</id>
    </mitre>
    <group>windows,persistence,</group>
  </rule>

  <!-- OneDrivePatcher -->
  <rule id="100015" level="12">
    <if_sid>61613</if_sid>
    <field name="win.eventdata.image">OneDrivePatcher.exe</field>
    <description>SUSPICIOUS: OneDrivePatcher.exe detected - verify legitimacy</description>
    <mitre>
      <id>T1036</id>
    </mitre>
  </rule>

  <!-- Registry Run Keys -->
  <rule id="100016" level="11">
    <if_sid>61699</if_sid>
    <field name="win.eventdata.targetObject" type="pcre2">\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Run\\|\\CurrentVersion\\RunOnce</field>
    <description>Registry Run key modified - potential persistence</description>
    <mitre>
      <id>T1547.001</id>
    </mitre>
    <group>windows,persistence,registry,</group>
  </rule>

  <rule id="100017" level="0">
    <if_sid>100016</if_sid>
    <field name="win.eventdata.details" type="pcre2">C:\\Program Files\\Microsoft Office|C:\\Program Files\\Adobe|C:\\Program Files\\Google</field>
    <description>Ignore legitimate Run Key from trusted software</description>
  </rule>

  <rule id="100018" level="14">
    <if_sid>100016</if_sid>
    <field name="win.eventdata.details" type="pcre2">AppData\\Roaming|Users\\Public|Temp</field>
    <description>CRITICAL: Registry Run key points to suspicious location</description>
    <mitre>
      <id>T1547.001</id>
    </mitre>
    <group>windows,persistence,registry,attack,</group>
  </rule>

  <rule id="100019" level="15">
    <if_sid>108016</if_sid>
    <field name="win.eventdata.details" type="pcre2">powershell\.exe.*-enc|powershell\.exe.*-encodedcommand</field>
    <description>CRITICAL: Registry Run key with encoded PowerShell</description>
    <mitre>
      <id>T1547.001</id>
      <id>T1059.001</id>
    </mitre>
    <group>windows,persistence,registry,powershell,attack,</group>
  </rule>

  <!-- Critical Events -->
  <rule id="100020" level="15">
    <if_sid>60800</if_sid>
    <field name="win.system.eventID">^1102$|^1041$</field>
    <description>CRITICAL: Security logs cleared! Possible cover-up activity</description>
    <mitre>
      <id>T1070.001</id>
    </mitre>
    <group>log_clearing,attack,</group>
  </rule>

  <rule id="100021" level="12">
    <if_sid>60800</if_sid>
    <field name="win.system.eventID">^2003$</field>
    <description>High Alert: Windows Firewall has been disabled or modified</description>
    <mitre>
      <id>T1562.004</id>
    </mitre>
    <group>defense_evasion,attack,</group>
  </rule>

  <rule id="100022" level="14">
    <if_sid>61603</if_sid>
    <field name="win.eventdata.commandLine" type="pcre2">vssadmin.*delete.*shadows|wmic.*shadowcopy.*delete|bcdedit.*recoveryenabled.*no</field>
    <description>CRITICAL: Ransomware activity - Shadow copies/recovery being disabled</description>
    <mitre>
      <id>T1490</id>
    </mitre>
    <group>ransomware,attack,</group>
  </rule>

  <!-- Lateral Movement -->
  <rule id="100023" level="11">
    <if_sid>61699</if_sid>
    <field name="win.eventdata.image" type="pcre2">\\psexec\.exe$|\\psexesvc\.exe$</field>
    <description>PsExec execution detected - potential lateral movement</description>
    <mitre>
      <id>T1569.002</id>
    </mitre>
    <group>windows,lateral_movement,</group>
  </rule>

  <rule id="100024" level="8">
    <if_sid>60000</if_sid>
    <field name="win.system.eventID">^5140$</field>
    <description>Administrative share accessed - potential lateral movement</description>
    <mitre>
      <id>T1021.002</id>
    </mitre>
    <group>windows,lateral_movement,smb,</group>
  </rule>

  <!-- Credential Dumping -->
  <rule id="100025" level="15">
    <if_sid>61699</if_sid>
    <field name="win.eventdata.commandLine" type="pcre2">lsass|procdump.*lsass</field>
    <description>CRITICAL: LSASS-related activity - credential dumping attempt</description>
    <mitre>
      <id>T1003.001</id>
    </mitre>
    <group>credential_dumping,attack,</group>
  </rule>

  <!-- Defender Disabled -->
  <rule id="100026" level="13">
    <if_sid>60000</if_sid>
    <field name="win.system.eventID">^5001$</field>
    <description>CRITICAL: Windows Defender Real-Time Protection disabled</description>
    <mitre>
      <id>T1562.001</id>
    </mitre>
    <group>windows,defense_evasion,</group>
  </rule>

  <!-- Override Sysmon regel 92205 för PowerShell policy test scripts -->
  <rule id="100027" level="0">
    <if_sid>61603</if_sid>
    <field name="win.system.eventID">^1$</field>
    <field name="win.eventdata.commandLine" type="pcre2">PSScriptPolicyTest</field>
    <description>Whitelist: Sysmon Event 1 - PowerShell policy test scripts</description>
  </rule>

</group>

<!-- ====================================== -->
<!-- Linux Security Rules (4 rules) -->
<!-- ====================================== -->

<group name="local,syscheck,linux">

  <!-- Rule 100040: Critical System File Modified -->
  <rule id="100040" level="12">
    <if_sid>550</if_sid>
    <field name="path" type="pcre2">/etc/passwd$|/etc/shadow$|/etc/sudoers$</field>
    <description>CRITICAL: System authentication file modified.</description>
    <mitre>
      <id>T1222</id>
      <id>T1098</id>
    </mitre>
    <group>syscheck,rootcheck,</group>
  </rule>

  <!-- Rule 100041: SSH Authorized keys Modified -->
  <rule id="100041" level="10">
    <if_sid>550</if_sid>
    <match>authorized_keys</match>
    <description>CRITICAL: SSH authorized_keys file modified - potential backdoor.</description>
    <mitre>
      <id>T1098.004</id>
    </mitre>
    <group>syscheck,ssh,persistence,</group>
  </rule>

  <!-- Rule 100042: Cron Job Created/Modified -->
  <rule id="100042" level="10">
    <if_sid>550</if_sid>
    <field name="path" type="pcre2">/etc/cron|/var/spool/cron</field>
    <description>Cron Job modified - potential persistence mechanism.</description>
    <mitre>
      <id>T1053.003</id>
    </mitre>
    <group>syscheck,persistence,</group>
  </rule>

  <!-- Rule 100043: Suspicious Sudo Usage -->
  <rule id="100043" level="8">
    <match>sudo: </match>
    <description>Sudo command executed by non-privileged user.</description>
    <mitre>
      <id>T1548.003</id>
    </mitre>
    <group>privilege_escalation,</group>
  </rule>

</group>

